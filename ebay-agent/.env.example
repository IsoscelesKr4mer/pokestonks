# eBay MCP credentials
# Copy to .env (gitignored) and fill in. Pull values from https://developer.ebay.com/my/keys

EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENVIRONMENT=production
EBAY_REDIRECT_URI=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_CONTENT_LANGUAGE=en-US

# Filled by `npx ebay-mcp setup` after the OAuth flow.
# Gives you 10k-50k req/day instead of 1k. Keep secret.
EBAY_USER_REFRESH_TOKEN=

# Optional: turn up logging when debugging
# EBAY_LOG_LEVEL=debug
# EBAY_ENABLE_FILE_LOGGING=true
