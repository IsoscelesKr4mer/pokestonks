# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*.local
# allow the template to be committed
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor
.vscode/
.idea/
*.swp

# os
Thumbs.db

# brainstorming companion (transient session data, not source)
.superpowers/

# playwright
test-results/
playwright-report/

# screenshots / scratch
*.png
*.jpg
*.jpeg
!public/**/*.png
!public/**/*.jpg
!public/**/*.jpeg
!components/**/*.png
!app/**/*.png
!tests/fixtures/*.png

# Drizzle introspection mirrors (regenerated via drizzle-kit pull when needed)
drizzle/schema.ts
drizzle/relations.ts

# personal/scratch reference material kept outside source
docs/references/
.claude/*
# Skills are shared project knowledge and must be tracked; local settings are not.
# The reference photos are the whole point of the card-intake skill, so they beat
# the blanket *.jpg rule above.
!.claude/skills/
!.claude/skills/**/*.jpg

# Raw capture footage. 400MB+ files, GitHub rejects anything over 100MB
# and these blocked 9 commits from pushing on 2026-08-16. Keep them local.
VM_Videos/
_bowman_cache.json

# Card photos off the phone: 2.2 GB, 1,104 files, and some .MOV over GitHub's
# 100 MB per-file limit. Source images belong in Supabase storage, not git
# history, and listing photos are hosted by eBay EPS anyway.
eBay_assets/card drop/
